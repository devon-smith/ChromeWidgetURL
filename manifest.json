{
  "manifest_version": 3,
  "name": "Local Toby — Tab Collections",
  "version": "0.1.0",
  "key": "",
  "description": "Local-first tab & collection manager. Save, organize, and restore tabs across spaces. All data stays on your machine — no account, no cloud.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "favicon",
    "sidePanel"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Local Toby",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "Open the Local Toby dashboard"
    },
    "save-current-tab": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current tab to the active collection"
    },
    "save-all-tabs": {
      "description": "Save all tabs in the current window to a new collection"
    },
    "toggle-side-panel": {
      "description": "Toggle the Open Tabs side panel"
    },
    "_execute_action": {}
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' chrome-extension: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "web_accessible_resources": [
    { "resources": ["_favicon/*"], "matches": ["<all_urls>"], "use_dynamic_url": true }
  ]
}
